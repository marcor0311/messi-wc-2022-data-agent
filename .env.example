DATABASE_URL=postgresql://postgres:postgres@localhost:5432/messi_wc_2022
# Proxy interno de Next.js; no se expone al navegador.
API_URL=http://127.0.0.1:8000
# OAuth tokens and local ChatGPT session state are stored here by the API at runtime.
# Do not copy a real value into this example file or commit .env.
# AGENT_AUTH_STATE_B64=<managed automatically by the local API>
# Opcional: ruta absoluta al artefacto Gold que debe leerse.
# GOLD_ARTIFACT=/ruta/data/gold/statsbomb/wc2022/v1-<load_id>
# Opcional: Silver padre de Gold con shots.jsonl, para la altura final del tiro.
# Se descubre por el hash del manifiesto; permite indicar una ruta alternativa.
# SHOT_HEIGHT_ARTIFACT=/ruta/data/silver/statsbomb/wc2022/v1-<hash>
# CONVERSATION_DB=/ruta/data/conversations.sqlite3
# Opcional: base SQLite analítica que usa el agente.
# AGENT_GOLD_DB=/ruta/data/agent/gold.sqlite3
# Opcional: callback OAuth loopback (debe ser http://127.0.0.1:<puerto>/auth/callback).
# AGENT_CALLBACK=http://127.0.0.1:8000/auth/callback
# Opcional: origen del frontend permitido por la API del agente.
# AGENT_WEB_ORIGIN=http://127.0.0.1:3000
