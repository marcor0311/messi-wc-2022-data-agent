DATABASE_URL=postgresql://postgres:postgres@localhost:5432/messi_wc_2022
# Proxy interno de Next.js; no se expone al navegador.
API_URL=http://127.0.0.1:8000
# Opcional: ruta absoluta al artefacto Gold que debe leerse.
# GOLD_ARTIFACT=/ruta/data/gold/statsbomb/wc2022/v1-<load_id>
# Opcional: Silver padre de Gold con shots.jsonl, para la altura final del tiro.
# Se descubre por el hash del manifiesto; permite indicar una ruta alternativa.
# SHOT_HEIGHT_ARTIFACT=/ruta/data/silver/statsbomb/wc2022/v1-<hash>
# CONVERSATION_DB=/ruta/data/conversations.sqlite3
